{
  "name": "rocky-skill-installer",
  "version": "1.1.0",
  "description": "Rocky skill installer: detects your AI coding agents and installs Rocky for each one. Rocky the Eridian from Project Hail Mary as your agent's voice. Fork of caveman by Julius Brussee.",
  "license": "Apache-2.0",
  "author": "Theralley",
  "homepage": "https://github.com/Theralley/rocky-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Theralley/rocky-skill.git"
  },
  "bugs": {
    "url": "https://github.com/Theralley/rocky-skill/issues"
  },
  "bin": {
    "rocky-install": "./installer/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-concurrency=2 tests/installer/*.test.mjs tests/hooks/*.test.mjs"
  },
  "files": [
    ".cursor-plugin/",
    "installer/",
    ".codex/codex-sessionstart.js",
    "hooks/",
    "src/",
    "agents/",
    "skills/",
    "plugins/",
    "commands/",
    "dist/rocky.skill",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!**/__pycache__/**",
    "!**/*.py[cod]"
  ]
}
